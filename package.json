{
  "name": "security-portfolio-sample",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/models.test.ts",
    "db:check": "node --conditions=react-server --import tsx scripts/check-db.ts"
  },
  "dependencies": {
    "@next/env": "^16.4.6",
    "@react-three/fiber": "9.8.2",
    "mongoose": "^9.13.1",
    "next": "16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
