# Server-only MongoDB connection string. Set a real value in .env.local or Vercel.
# Example for local MongoDB: mongodb://127.0.0.1:27017/websec_portfolio
MONGODB_URI=

# GitHub OAuth app credentials; these must never use a NEXT_PUBLIC_ prefix.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Numeric GitHub account ID, not the username.
ADMIN_GITHUB_ID=
